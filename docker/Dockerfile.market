# SECURE: Multi-stage build for smaller attack surface
FROM golang:1.25.4-alpine AS builder

RUN apk add --no-cache \
	gcc \
	musl-dev \
	make \
	ca-certificates

WORKDIR /build

COPY go.mod go.sum ./ 

RUN go mod tidy
RUN go mod download && go mod verify

COPY . .

# CGO is required to build chai2010/webp package
ENV CGO_ENABLED=1 GOOS=linux

# SECURE: Build with security flags
RUN go build -tags timetzdata -ldflags="-w -s -extldflags '-fno-PIC'" -o market ./cmd/market

# SECURE: Final stage using distroless for minimal image
FROM gcr.io/distroless/base-debian13:nonroot

# SECURE: Add CA certificates for HTTPS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

WORKDIR /app

# SECURE: Use read-only filesystem where possible
COPY --chown=nonroot:nonroot static/ static/
COPY --chown=nonroot:nonroot ui/ ui/ 
COPY --from=builder --chown=nonroot:nonroot /build/market .

# SECURE: Drop all capabilities
USER nonroot

# SECURE: No shell available for attacker
ENTRYPOINT ["./market"]
