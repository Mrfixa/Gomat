# Myrmidons Environment Configuration

# Database
DSN=postgresql://postgres:password@localhost:5432/myrmidons?sslmode=disable

# Security (generate with: openssl rand -base64 32)
CSRF_AUTH_KEY=changeme32byteslongsecretkey!!

# Tor
TOR_SOCKS=127.0.0.1:9050
ONION_ADDRESS=your-onion-address.onion

# Monero
MONERO_RPC=http://localhost:38083
VIEW_KEY=your-view-key
SIGN_KEY=your-sign-key

# Market Settings
OPERATOR_BOND=10000000000000
INSURANCE_PERCENT=2.0
DEFAULT_FEE=5.0
ZERO_FEE_THRESHOLD=1000

# Development
DEV_MODE=false

# Server
ADDR=0.0.0.0:4000
